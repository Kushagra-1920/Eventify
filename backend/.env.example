# Backend Environment Variables Template
# DO NOT COMMIT ACTUAL VALUES TO GITHUB

# --- Profile Configuration ---
# Set to 'prod' for production (Railway) or 'dev' for local
SPRING_PROFILES_ACTIVE=dev

# --- Database Configuration ---
# MySQL Database URL (e.g. jdbc:mysql://localhost:3306/ticket_booking)
MYSQL_URL=YOUR_DATABASE_URL
MYSQLUSER=YOUR_DATABASE_USERNAME
MYSQLPASSWORD=YOUR_DATABASE_PASSWORD

# --- Security ---
# Secret for signing JWT tokens (should be a long random string)
JWT_SECRET=YOUR_JWT_SECRET

# --- Google OAuth2 ---
# Google OAuth Client Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# --- Payment Integration (Razorpay) ---
# Razorpay Credentials
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# --- Server & CORS Configuration ---
# Server Port (e.g. 8080)
PORT=8080
# URL where the frontend is hosted (e.g. http://localhost:5173 for local, https://your-frontend.vercel.app for prod)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
